{
  "name": "ported-games-egret",
  "private": true,
  "type": "module",
  "description": "基于新白鹭引擎独立开发的游戏 Demo · Game demos built on the new Egret engine",
  "scripts": {
    "create": "node tools/create-game.mjs",
    "check": "node tools/check-standard.mjs",
    "check:showcase": "node tools/check-showcase.mjs",
    "notes": "node tools/engine-notes.mjs",
    "duplication": "node tools/duplication.mjs",
    "showcase:admin": "node tools/showcase-admin/index.mjs",
    "test:showcase-admin": "node --test tools/showcase-admin/*.test.mjs",
    "test:template": "cd templates/egret-game && node --test test/*.test.mjs && node test/accept.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
